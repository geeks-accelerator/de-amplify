{
  "name": "de-amplify",
  "version": "0.1.0",
  "private": true,
  "description": "de-amplify: the thing it broke was the brake. A design-and-parental-controls proposal for engagement feeds and minors. de-amplify.com",
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dates": "node scripts/content-dates.mjs",
    "check:dates": "node scripts/content-dates.mjs --check",
    "check:ledgers": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-ledgers.mjs",
    "check:quotes": "node scripts/check-quotes.mjs",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "check:distillations": "node scripts/check-distillations.mjs",
    "check:issues": "node scripts/check-issues.mjs",
    "check:guards": "node scripts/check-guards.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "geist": "^1.8.2",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "^6"
  },
  "overrides": {
    "typescript-eslint": "8.72.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript-eslint/utils": "8.72.0",
    "@typescript-eslint/typescript-estree": "8.72.0",
    "@typescript-eslint/type-utils": "8.72.0",
    "@typescript-eslint/scope-manager": "8.72.0",
    "@typescript-eslint/visitor-keys": "8.72.0",
    "@typescript-eslint/types": "8.72.0",
    "postcss-selector-parser": "7.1.7"
  }
}
